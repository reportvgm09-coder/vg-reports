# start-app creates .env for you on first run. This is only a reference.
# Login(s): name:password, comma-separated for more than one
APP_USERS=owner:change-me
PORT=3000
# Leave DATABASE_URL unset on your computer (data is kept in ./data).
# On Render it is set automatically.
# DATABASE_URL=postgres://user:pass@host:5432/vg_reports
# Optional: read-only MongoDB user for the Sales Order app (Orders page)
ORDERS_MONGO_URL=
ORDERS_DB_NAME=sale_order_db
