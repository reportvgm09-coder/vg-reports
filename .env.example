# Copy to .env for local runs (node --env-file=.env src/server.js)
DATABASE_URL=postgres://postgres@127.0.0.1:5432/vg_reports
SESSION_SECRET=change-me-to-a-long-random-string
APP_USERS=owner:change-me,accounts:change-me-too
PORT=3000
# Optional: read-only MongoDB user for the Sales Order app (Orders page)
ORDERS_MONGO_URL=
ORDERS_DB_NAME=sale_order_db
